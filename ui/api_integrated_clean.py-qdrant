                    "service": "qdrant-vector-database",
                    "display_name": "🔍 Vector Database (Qdrant)",
                    "type": "database",
                    "purpose": "Store and search document embeddings",
                    "endpoint": f"http://{enhanced_query_engine.qdrant_host if enhanced_query_engine else 'localhost'}:6333"
                },
                {
                    "service": "openai-completion-api",
                    "display_name": "🤖 OpenAI Completion API", 
                    "type": "external_ai_service",
                    "purpose": "Generate intelligent responses from document context",
                    "endpoint": "https://api.openai.com"
                }
            ],
            "business_flows": [
                {
                    "name": "user_question_flow",
                    "display_name": "👤➡️📚➡️🤖➡️💬 User Question Processing",
                    "steps": [
                        "User submits question",
                        "Search vector database for relevant documents", 
                        "Generate AI response from documents",
                        "Return formatted answer with citations"
                    ]
                },
                {
                    "name": "document_processing_flow",
                    "display_name": "📁➡️📄➡️🔍➡️💾 Document Processing",
                    "steps": [
                        "Scan for new documents",
                        "Extract text and metadata", 
                        "Generate embeddings",
                        "Store in vector database"
                    ]
                }
            ],
            "trace_context": {
                "current_trace_id": get_current_trace_id(),
                "service_hierarchy": "document-rag-orchestrator -> document-rag-api",
                "w3c_propagation": "enabled"
            }
        }
        
        span.set_attributes({
            "service_map.generated": True,
            "service_map.components_count": len(service_map["current_service"]["components"]),
            "service_map.dependencies_count": len(service_map["external_dependencies"]),
            "service_map.business_flows_count": len(service_map["business_flows"])
        })
        
        return service_map

# ENHANCED: WebSocket endpoint with business context
@app.websocket("/api/ws")
async def websocket_endpoint(websocket: WebSocket):
    """WebSocket for real-time query processing with enhanced tracing"""
    with tracer.start_as_current_span("🔌 WebSocket_Real_Time_Query_Connection") as span:
        span.set_attributes({
            "service.name": "document-rag-api",
            "service.component": "realtime-query-handler",
            "connection.type": "websocket",
            "business.operation": "establish_realtime_user_connection",
            "operation.description": "Establishing real-time connection for interactive document queries"
        })
        
        await websocket.accept()
        connection_id = str(uuid.uuid4())[:8]
        
        span.set_attributes({
            "websocket.connection_id": connection_id,
            "websocket.connected": True
        })
        
        logger.info_with_context(
            f"WebSocket connection established for real-time queries ({connection_id})",
            extra_attributes={
                "websocket.connection_id": connection_id,
                "business.operation": "realtime_connection_established",
                "operation": "websocket_connection"
            }
        )
        
        try:
            while True:
                # Wait for message from client
                data = await websocket.receive_text()
                message_data = json.loads(data)
                
                with tracer.start_as_current_span("💬 Process_Realtime_User_Query") as query_span:
                    query_span.set_attributes({
                        "service.component": "realtime-query-processor",
                        "business.operation": "process_realtime_question",
                        "websocket.connection_id": connection_id,
                        "query.type": "realtime",
                        "operation.description": "Processing user question via WebSocket real-time connection"
                    })
                    
                    if enhanced_query_engine and message_data.get("query"):
                        query_request = QueryRequest(
                            query=message_data["query"],
                            session_id=message_data.get("session_id"),
                            citation_format=message_data.get("citation_format", "apa"),
                            max_sources=message_data.get("max_sources", 5)
                        )
                        
                        result = await enhanced_query_engine.process_query(query_request)
                        
                        response_data = {
                            "type": "query_response",
                            "data": result.dict(),
                            "trace_id": get_current_trace_id(),
                            "connection_id": connection_id
                        }
                        
                        await websocket.send_text(json.dumps(response_data))
                        
                        query_span.set_attributes({
                            "realtime.query_processed": True,
                            "response.sent": True
                        })
                        
                        logger.info_with_context(
                            f"Real-time query processed and response sent ({connection_id})",
                            extra_attributes={
                                "websocket.connection_id": connection_id,
                                "query.processed": True,
                                "business.operation": "realtime_query_processing",
                                "operation": "websocket_query"
                            }
                        )
                    else:
                        error_response = {
                            "type": "error",
                            "message": "Query engine not available or invalid query",
                            "trace_id": get_current_trace_id()
                        }
                        await websocket.send_text(json.dumps(error_response))
                        
                        query_span.set_attributes({
                            "realtime.query_failed": True,
                            "error.reason": "invalid_request_or_service_unavailable"
                        })
        
        except WebSocketDisconnect:
            span.set_attributes({
                "websocket.disconnected": True,
                "disconnect.type": "client_initiated"
            })
            logger.info_with_context(
                f"WebSocket client disconnected ({connection_id})",
                extra_attributes={
                    "websocket.connection_id": connection_id,
                    "disconnect.type": "client_initiated",
                    "business.operation": "realtime_connection_closed",
                    "operation": "websocket_disconnect"
                }
            )
        except Exception as e:
            span.record_exception(e)
            span.set_attributes({
                "websocket.error": True,
                "business.impact": "realtime_connection_lost"
            })
            logger.error_with_context(
                f"WebSocket error for connection {connection_id}",
                extra_attributes={
                    "websocket.connection_id": connection_id,
                    "error.type": type(e).__name__,
                    "error.message": str(e),
                    "business.operation": "realtime_query_processing",
                    "operation": "websocket_error"
                },
                exc_info=True
            )

